    "leaflet": "1.9.4",
    "netcdfjs": "4.0.0",
    "next": "16.4.6",
    "pbf": "5.1.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  }
}
